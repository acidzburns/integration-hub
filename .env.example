# Copy this file to .env.local and fill in your own values.
# .env.local is never uploaded to GitHub, so your password stays on your laptop.
# Leave these empty to run without ServiceNow.

SERVICENOW_INSTANCE=https://dev12345.service-now.com
SERVICENOW_USER=integration.hub
SERVICENOW_PASSWORD=
# Optional: close code used when resolving incidents
# SERVICENOW_CLOSE_CODE=Solution provided
